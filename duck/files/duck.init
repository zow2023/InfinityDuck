#!/bin/sh /etc/rc.common
# Copyright (C) 2023 Tianling Shen <cnsztl@immortalwrt.org>

USE_PROCD=1
START=99
STOP=10

extra_command "hot_reload" "Refresh remote config and hot-reload service"
extra_command "refresh_config" "Refresh remote configuration only"
extra_command "check_config" "Validate current configuration"

CONF="duck"
PROG="/usr/bin/dae"

BASE_DIR="/etc/duck"
LOG_DIR="/var/log/duck"
LOG_FILE="${LOG_DIR}/duck.log"

CRON_ID="duck_scheduled_restart"
AUTO_UPDATE_CRON_ID="duck_subscribe_auto_update"

DAE_HOST_IFACE="dae0"
DAE_PEER_IFACE="dae0peer"
DAENETNS_NAME="daens"
DAENETNS="/run/netns/${DAENETNS_NAME}"
RESOLV_DAE="/tmp/resolv.conf.duck"
DAE_PID_FILE="/var/run/dae.pid"

log_message() {
    local msg="$1"
    local level="${2:-info}"
    local timestamp

    mkdir -p "$LOG_DIR" 2>/dev/null || return 1
    timestamp="$(date '+%Y-%m-%d %H:%M:%S')"
    echo "[$timestamp] [duck] [$level] $msg" >> "$LOG_FILE" 2>/dev/null
}

ensure_runtime_dirs() {
    install -d -m 750 "$BASE_DIR" "$BASE_DIR/config.d" "$LOG_DIR" 2>/dev/null || {
        mkdir -p "$BASE_DIR" "$BASE_DIR/config.d" "$LOG_DIR" 2>/dev/null || return 1
        chmod 750 "$BASE_DIR" "$BASE_DIR/config.d" "$LOG_DIR" 2>/dev/null || true
    }

    [ -e "$LOG_FILE" ] || : > "$LOG_FILE"
    chmod 640 "$LOG_FILE" 2>/dev/null || true
}

is_uint() {
    case "$1" in
        ''|*[!0-9]*)
            return 1
        ;;
        *)
            return 0
        ;;
    esac
}

stable_minute() {
    local seed file

    for file in \
        /etc/machine-id \
        /proc/sys/kernel/hostname \
        /sys/class/net/br-lan/address \
        /sys/class/net/eth0/address
    do
        if [ -r "$file" ]; then
            seed="$(cat "$file" 2>/dev/null)"
            [ -n "$seed" ] && break
        fi
    done

    [ -n "$seed" ] || seed="duck"
    printf '%s\n' "$seed" | cksum | awk '{ print $1 % 60 }'
}

_filter_duck_cron_to() {
    local out_file="$1"

    if [ -f /etc/crontabs/root ]; then
        sed "/#${CRON_ID}\$/d;/#${AUTO_UPDATE_CRON_ID}\$/d" /etc/crontabs/root > "$out_file" 2>/dev/null || : > "$out_file"
    else
        : > "$out_file"
    fi
}

_apply_cron_file() {
    local tmp_cron="$1"

    if cmp -s "$tmp_cron" /etc/crontabs/root 2>/dev/null; then
        rm -f "$tmp_cron"
        return 1
    fi

    mv -f "$tmp_cron" /etc/crontabs/root || {
        rm -f "$tmp_cron"
        return 1
    }

    /etc/init.d/cron reload >/dev/null 2>&1 || /etc/init.d/cron restart >/dev/null 2>&1 || true
    return 0
}

clear_cron_entries() {
    local tmp_cron

    tmp_cron="$(mktemp /tmp/duck.root.cron.XXXXXX)" || return 1
    _filter_duck_cron_to "$tmp_cron"

    if _apply_cron_file "$tmp_cron"; then
        log_message "Cron entries cleared"
    fi
}

setup_cron_jobs() {
    local tmp_cron
    local scheduled_restart cron_expression
    local subscribe_auto_update subscribe_update_day_time subscribe_update_week_time
    local min

    tmp_cron="$(mktemp /tmp/duck.root.cron.XXXXXX)" || return 1
    _filter_duck_cron_to "$tmp_cron"

    config_get_bool scheduled_restart "config" "scheduled_restart" "0"
    config_get cron_expression "config" "cron_expression" ""

    if [ "$scheduled_restart" -eq 1 ] && [ -n "$cron_expression" ]; then
        echo "$cron_expression /etc/init.d/duck restart #${CRON_ID}" >> "$tmp_cron"
        log_message "Scheduled restart enabled: $cron_expression"
    elif [ "$scheduled_restart" -eq 1 ]; then
        log_message "Scheduled restart is enabled but cron_expression is empty" "warn"
    fi

    config_get_bool subscribe_auto_update "config" "subscribe_auto_update" "0"
    config_get subscribe_update_day_time "config" "subscribe_update_day_time" "*"
    config_get subscribe_update_week_time "config" "subscribe_update_week_time" "*"

    if [ "$subscribe_auto_update" -eq 1 ]; then
        min="$(stable_minute)"
        echo "$min ${subscribe_update_day_time} * * ${subscribe_update_week_time} /etc/init.d/duck hot_reload >/dev/null 2>&1 #${AUTO_UPDATE_CRON_ID}" >> "$tmp_cron"
        log_message "Subscription auto-update enabled: minute=$min hour=${subscribe_update_day_time} week=${subscribe_update_week_time}"
    fi

    if _apply_cron_file "$tmp_cron"; then
        log_message "Cron entries updated"
    fi
}

cleanup_netns() {
    tc qdisc del dev "$DAE_HOST_IFACE" clsact 2>/dev/null || true
    ip link del "$DAE_HOST_IFACE" 2>/dev/null || true
    ip link del "$DAE_PEER_IFACE" 2>/dev/null || true
    ip netns del "$DAENETNS_NAME" 2>/dev/null || true
    rm -f "$DAENETNS" 2>/dev/null || true
}

is_mount_target() {
    local target="$1"
    awk -v t="$target" '$2 == t { found=1 } END { exit(found ? 0 : 1) }' /proc/mounts
}

is_bind_mounted_from() {
    local source="$1"
    local target="$2"
    awk -v s="$source" -v t="$target" '$1 == s && $2 == t { found=1 } END { exit(found ? 0 : 1) }' /proc/mounts
}

prepare_resolv_conf() {
    local dns_list LOGICAL_WAN dns
    local resolv_src="/tmp/resolv.conf"

    if [ -f "$resolv_src" ]; then
        grep -E '^(search|domain) ' "$resolv_src" > "$RESOLV_DAE" 2>/dev/null || : > "$RESOLV_DAE"
    else
        : > "$RESOLV_DAE"
    fi

    . /lib/functions/network.sh

    network_find_wan LOGICAL_WAN 2>/dev/null
    if [ -n "$LOGICAL_WAN" ]; then
        dns_list="$(ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null | jsonfilter -e '@["dns-server"][*]' 2>/dev/null)"
    fi

    if [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ]; then
        dns_list="$(awk '/^nameserver/{print $2}' /tmp/resolv.conf.d/resolv.conf.auto)"
    fi

    [ -n "$dns_list" ] || dns_list="119.29.29.29 223.5.5.5"

    for dns in $dns_list; do
        echo "nameserver $dns" >> "$RESOLV_DAE"
    done

    chmod 644 "$RESOLV_DAE" 2>/dev/null || true
}

hijack_resolv_conf() {
    local resolv_path="/tmp/resolv.conf"

    [ -L "$resolv_path" ] && resolv_path="$(readlink -f "$resolv_path" 2>/dev/null)"
    [ -n "$resolv_path" ] || resolv_path="/tmp/resolv.conf"

    if is_bind_mounted_from "$RESOLV_DAE" "$resolv_path"; then
        return 0
    fi

    if is_mount_target "$resolv_path"; then
        log_message "resolv.conf is already mounted by another source, skip hijack" "warn"
        return 1
    fi

    prepare_resolv_conf || {
        log_message "Failed to prepare replacement resolv.conf" "warn"
        rm -f "$RESOLV_DAE"
        return 1
    }

    mount --bind "$RESOLV_DAE" "$resolv_path" 2>/dev/null || {
        log_message "Failed to bind resolv.conf" "warn"
        rm -f "$RESOLV_DAE"
        return 1
    }

    mount -o remount,bind,ro "$RESOLV_DAE" "$resolv_path" 2>/dev/null || {
        log_message "Failed to remount resolv.conf read-only, rolling back" "warn"
        umount "$resolv_path" 2>/dev/null || true
        rm -f "$RESOLV_DAE"
        return 1
    }

    log_message "resolv.conf hijacked successfully"
    return 0
}

restore_resolv_conf() {
    local resolv_path="/tmp/resolv.conf"

    [ -L "$resolv_path" ] && resolv_path="$(readlink -f "$resolv_path" 2>/dev/null)"
    [ -n "$resolv_path" ] || resolv_path="/tmp/resolv.conf"

    if ! is_bind_mounted_from "$RESOLV_DAE" "$resolv_path"; then
        rm -f "$RESOLV_DAE" 2>/dev/null || true
        return 0
    fi

    mount -o remount,bind,rw "$RESOLV_DAE" "$resolv_path" 2>/dev/null || true
    umount "$resolv_path" 2>/dev/null || true
    rm -f "$RESOLV_DAE" 2>/dev/null || true

    log_message "resolv.conf restored"
}

validate_config_file() {
    local config_file="$1"

    [ -n "$config_file" ] || return 1
    [ -f "$config_file" ] || return 1
    "$PROG" validate -c "$config_file" >/dev/null 2>&1
}

fetch_remote_config() {
    local config_file="$1"
    local subscribe_url="$2"
    local subscribe_enabled="${3:-0}"
    local tmp_conf

    if [ "$subscribe_enabled" != "1" ] || [ -z "$subscribe_url" ]; then
        return 1
    fi

    tmp_conf="$(mktemp "${BASE_DIR}/config.download.XXXXXX")" || {
        log_message "Failed to create temporary config file" "error"
        return 1
    }

    log_message "Downloading configuration from $subscribe_url"

    if ! wget -q --timeout=15 -O "$tmp_conf" "$subscribe_url" 2>/dev/null; then
        log_message "Failed to download configuration, keeping current one" "warn"
        rm -f "$tmp_conf"
        return 1
    fi

    chmod 600 "$tmp_conf" 2>/dev/null || true

    if ! "$PROG" validate -c "$tmp_conf" >/dev/null 2>&1; then
        log_message "Downloaded configuration is invalid, keeping current one" "warn"
        rm -f "$tmp_conf"
        return 1
    fi

    mkdir -p "$(dirname "$config_file")" 2>/dev/null || true

    if [ -f "$config_file" ] && cmp -s "$tmp_conf" "$config_file" 2>/dev/null; then
        rm -f "$tmp_conf"
        log_message "Remote configuration unchanged"
        return 0
    fi

    if ! mv -f "$tmp_conf" "$config_file"; then
        log_message "Failed to replace configuration file" "error"
        rm -f "$tmp_conf"
        return 1
    fi

    chmod 600 "$config_file" 2>/dev/null || true
    log_message "Successfully updated configuration"
    return 0
}

reload_daemon() {
    if ! /etc/init.d/duck running >/dev/null 2>&1; then
        log_message "duck is not running, cannot hot-reload" "warn"
        return 1
    fi

    if [ -r "$DAE_PID_FILE" ]; then
        "$PROG" reload "$(cat "$DAE_PID_FILE" 2>/dev/null)" >/dev/null 2>&1 && return 0
    fi

    "$PROG" reload >/dev/null 2>&1
}

load_runtime_config() {
    config_load "$CONF"

    config_get_bool enabled "config" "enabled" "0"
    config_get delay "config" "delay" "0"
    config_get config_file "config" "config_file" "${BASE_DIR}/config.dae"
    config_get subscribe_url "config" "subscribe_url" ""
    config_get_bool subscribe_enabled "config" "subscribe_enabled" "0"
    config_get log_maxbackups "config" "log_maxbackups" "1"
    config_get log_maxsize "config" "log_maxsize" "1"
    config_get_bool disable_timestamp "config" "disable_timestamp" "0"

    is_uint "$delay" || delay=0
    is_uint "$log_maxbackups" || log_maxbackups=1
    is_uint "$log_maxsize" || log_maxsize=1
}

start_service() {
    local enabled delay config_file
    local subscribe_url subscribe_enabled
    local log_maxbackups log_maxsize
    local disable_timestamp

    load_runtime_config

    [ "$enabled" -eq 1 ] || {
        log_message "Service is disabled by configuration"
        return 0
    }

    [ -x "$PROG" ] || {
        log_message "dae binary not found or not executable: $PROG" "error"
        return 1
    }

    ensure_runtime_dirs || {
        log_message "Failed to prepare runtime directories" "error"
        return 1
    }

    setup_cron_jobs || log_message "Failed to setup cron jobs" "warn"

    if [ "$delay" -gt 0 ]; then
        log_message "Starting after $delay seconds"
        sleep "$delay"
    fi

    fetch_remote_config "$config_file" "$subscribe_url" "$subscribe_enabled" || true

    if ! validate_config_file "$config_file"; then
        log_message "Invalid configuration file: $config_file" "error"
        return 1
    fi

    hijack_resolv_conf || true
    cleanup_netns

    procd_open_instance "$CONF"

    uname -r | grep -Eq '^6\.6([.-]|$)' && procd_set_param env QUIC_GO_DISABLE_GSO="true"
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/dae"

    procd_set_param command "$PROG" run
    procd_append_param command --config "$config_file"
    [ "$disable_timestamp" -eq 1 ] && procd_append_param command --disable-timestamp
    procd_append_param command --logfile "$LOG_FILE"
    procd_append_param command --logfile-maxbackups "$log_maxbackups"
    procd_append_param command --logfile-maxsize "$log_maxsize"

    procd_set_param file "$config_file"
    procd_set_param limits core="0"
    procd_set_param limits nofile="65535 65535"
    procd_set_param respawn
    procd_set_param stderr 1

    procd_close_instance
    log_message "duck started successfully"
}

reload_service() {
    log_message "Reload requested, performing full restart"
    stop
    start
}

stop_service() {
    log_message "Stopping service"
    clear_cron_entries
    restore_resolv_conf
    cleanup_netns
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

refresh_config() {
    local enabled config_file subscribe_url subscribe_enabled

    ensure_runtime_dirs || return 1
    load_runtime_config

    [ "$enabled" -eq 1 ] || {
        log_message "Service is disabled, skip configuration refresh"
        return 1
    }

    [ -x "$PROG" ] || {
        log_message "dae binary not found or not executable: $PROG" "error"
        return 1
    }

    if fetch_remote_config "$config_file" "$subscribe_url" "$subscribe_enabled"; then
        return 0
    fi

    return 1
}

check_config() {
    local config_file

    load_runtime_config

    if validate_config_file "$config_file"; then
        log_message "Configuration validation passed: $config_file"
        return 0
    fi

    log_message "Configuration validation failed: $config_file" "error"
    return 1
}

hot_reload() {
    local config_file

    ensure_runtime_dirs || return 1
    load_runtime_config

    [ -x "$PROG" ] || {
        log_message "dae binary not found or not executable: $PROG" "error"
        return 1
    }

    refresh_config || true

    if ! validate_config_file "$config_file"; then
        log_message "Configuration validation failed before hot-reload: $config_file" "error"
        return 1
    fi

    if reload_daemon; then
        log_message "Hot-reload completed successfully"
        return 0
    fi

    log_message "Hot-reload failed, falling back to full restart" "warn"
    /etc/init.d/duck restart >/dev/null 2>&1
}
