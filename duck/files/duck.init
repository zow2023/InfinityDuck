#!/bin/sh /etc/rc.common
# Copyright (C) 2023-2026 Tianling Shen <cnsztl@immortalwrt.org>

USE_PROCD=1
START=99
STOP=10

extra_command "hot_reload" "Hot-reload service"

CONF="duck"
PROG="/usr/bin/dae"
LOG_DIR="/var/log/duck"
LOG_FILE="$LOG_DIR/duck.log"
CRON_ID="duck_scheduled_restart"
RESOLV_DAE="/tmp/resolv.conf.dae"

DAE_HOST_IFACE="dae0"                                                                                                                                                                        
DAE_PEER_IFACE="dae0peer"                                                                   
DAENETNS="/run/netns/daens"

log_message() {
    mkdir -p "$LOG_DIR" 2>/dev/null || return 1
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [duck] [${2:-info}] $1" >> "$LOG_FILE" 2>/dev/null
}

init_permissions_and_dirs() {
    mkdir -p /etc/duck /etc/duck/config.d "$LOG_DIR" || return 1
    find /etc/duck -type d -print0 2>/dev/null | xargs -0 chmod 750 2>/dev/null || true
    find /etc/duck -type f -print0 2>/dev/null | xargs -0 chmod 640 2>/dev/null || true
    chmod 750 "$LOG_DIR" 2>/dev/null || true
}

cleanup_netns() {
    if ip link show "$DAE_HOST_IFACE" >/dev/null 2>&1; then
        tc qdisc del dev "$DAE_HOST_IFACE" clsact 2>/dev/null || true
        ip link del "$DAE_HOST_IFACE" 2>/dev/null || true
    fi

    if ip link show "$DAE_PEER_IFACE" >/dev/null 2>&1; then
        ip link del "$DAE_PEER_IFACE" 2>/dev/null || true
    fi

    if [ -e "$DAENETNS" ] || ip netns list 2>/dev/null | grep -q "^daens$"; then
        ip netns del daens 2>/dev/null || true
        rm -f "$DAENETNS" 2>/dev/null || true
    fi
}

hijack_resolv_conf() {
    grep -q ' /tmp/resolv\.conf ' /proc/mounts && return 0
    grep -E '^(search|domain) ' /tmp/resolv.conf > "$RESOLV_DAE" 2>/dev/null

    local dns_list LOGICAL_WAN default_dns
    . /lib/functions/network.sh
    network_find_wan LOGICAL_WAN 2>/dev/null
    
    [ -n "$LOGICAL_WAN" ] && dns_list="$(ubus call "network.interface.$LOGICAL_WAN" status 2>/dev/null | jsonfilter -e '@["dns-server"][*]' 2>/dev/null)"
    [ -z "$dns_list" ] && [ -f "/tmp/resolv.conf.d/resolv.conf.auto" ] && dns_list="$(awk '/^nameserver/{print $2}' "/tmp/resolv.conf.d/resolv.conf.auto")"
    [ -z "$dns_list" ] && default_dns="119.29.29.29 223.5.5.5" && dns_list="$default_dns"

    for dns in $dns_list; do
        if echo "$dns" | grep -Eq '^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$'; then
            echo "nameserver $dns" >> "$RESOLV_DAE"
        fi
    done
    
    mount --bind "$RESOLV_DAE" /tmp/resolv.conf && mount -o remount,ro,bind /tmp/resolv.conf 2>/dev/null
    log_message "DNS hijack enabled, using: $dns_list"
}

restore_resolv_conf() {
    grep -q ' /tmp/resolv\.conf ' /proc/mounts || return 0
    mount -o remount,rw,bind /tmp/resolv.conf 2>/dev/null
    umount /tmp/resolv.conf 2>/dev/null
    rm -f "$RESOLV_DAE"
    log_message "DNS hijack restored"
}

setup_scheduled_restart() {
    local scheduled_restart cron_expression
    config_get_bool scheduled_restart "config" "scheduled_restart" "0"
    config_get cron_expression "config" "cron_expression" ""

    sed -i "/${CRON_ID}/d" /etc/crontabs/root 2>/dev/null

    if [ "$scheduled_restart" -eq 1 ] && [ -n "$cron_expression" ]; then
        echo "$cron_expression /etc/init.d/duck restart #${CRON_ID}" >> /etc/crontabs/root
        log_message "Scheduled restart expression: $cron_expression"
        /etc/init.d/cron restart 2>/dev/null || true
    elif [ "$scheduled_restart" -eq 1 ]; then
        log_message "Scheduled restart is enabled but expression is invalid" "warn"
    fi
}

update_config_from_url() {
    local config_file="$1" subscribe_url="$2" reload_only="${3:-0}" subscribe_enabled="$4"
    [ "$subscribe_enabled" = "1" ] && [ -n "$subscribe_url" ] || return 1

    local tmp_conf="/etc/duck/config.tmp.dae"
    local bak_conf="/etc/duck/config.dae.bak"
    [ -f "$config_file" ] && cp -f "$config_file" "$bak_conf"

    log_message "Downloading configuration from $subscribe_url"
    if wget -q --timeout=8 -O "$tmp_conf" "$subscribe_url" 2>/dev/null && \
       chmod 0600 "$tmp_conf" && \
       "$PROG" validate -c "$tmp_conf" >/dev/null 2>&1; then
        mv -f "$tmp_conf" "$config_file"
        rm -f "$bak_conf"
        log_message "Successfully updated configuration"
        if [ "$reload_only" -eq 1 ] && /etc/init.d/duck running >/dev/null 2>&1; then
            hot_reload
        fi
        return 0
    else
        log_message "Download failed or configuration invalid, roll back" "warn"
        rm -f "$tmp_conf"
        [ -f "$bak_conf" ] && mv -f "$bak_conf" "$config_file"
        return 1
    fi
}

start_service() {
    uci commit "$CONF" 2>/dev/null
    config_load "$CONF"

    local enabled delay config_file subscribe_url subscribe_enabled
    config_get_bool enabled "config" "enabled" "0"
    [ "$enabled" -eq 1 ] || return 1

    [ -x "$PROG" ] || {
        log_message "dae binary not found or not executable: $PROG" "error"
        return 1
    }

    config_get delay "config" "delay" "0"
    config_get config_file "config" "config_file" "/etc/duck/config.dae"
    config_get subscribe_url "config" "subscribe_url" ""
    config_get_bool subscribe_enabled "config" "subscribe_enabled" "0"

    init_permissions_and_dirs || {
        log_message "Failed to initialize directories and permissions" "error"
        return 1
    }
    
    cleanup_netns
    hijack_resolv_conf
    setup_scheduled_restart

    if [ "$delay" -gt 0 ]; then
        log_message "Starting after $delay seconds..."
        sleep "$delay"
    fi

    update_config_from_url "$config_file" "$subscribe_url" 0 "$subscribe_enabled" || \
        log_message "Configuration update failed, using existing config" "warn"

    "$PROG" validate -c "$config_file" >/dev/null 2>&1 || {
        log_message "Invalid configuration file: $config_file" "error"
        restore_resolv_conf
        return 1
    }

    local log_maxbackups log_maxsize
    config_get log_maxbackups "config" "log_maxbackups" "1"
    config_get log_maxsize "config" "log_maxsize" "1"

    procd_open_instance "$CONF"
    
    if uname -r | grep -Eq "^6\.6"; then
        procd_set_param env "QUIC_GO_DISABLE_GSO"="true"
    fi
    
    procd_set_param env DAE_LOCATION_ASSET="/usr/share/v2ray"
    procd_set_param command "$PROG" run
    procd_append_param command --config "$config_file"
    procd_append_param command --logfile "$LOG_FILE"
    procd_append_param command --logfile-maxbackups "$log_maxbackups"
    procd_append_param command --logfile-maxsize "$log_maxsize"

    procd_set_param limits core="unlimited"
    procd_set_param limits nofile="1000000 1000000"
    procd_set_param respawn
    procd_set_param stderr 1
    procd_close_instance
    
    log_message "InfinityDuck started successfully"
}

reload_service() {
    config_load "$CONF"
    local enabled
    config_get_bool enabled "config" "enabled" "0"
    [ "$enabled" -eq 1 ] || {
        stop
        return 0
    }

    local config_file old_url new_url subscribe_enabled
    config_get config_file "config" "config_file" "/etc/duck/config.dae"
    config_get_bool subscribe_enabled "config" "subscribe_enabled" "0"
    old_url="$(uci -q get duck.config.subscribe_url_last || echo '')"
    config_get new_url "config" "subscribe_url" ""

    if [ "$old_url" != "$new_url" ] && update_config_from_url "$config_file" "$new_url" 1 "$subscribe_enabled"; then
        uci set duck.config.subscribe_url_last="$new_url" && uci commit duck
        return 0
    fi

    setup_scheduled_restart
    
    if /etc/init.d/duck running >/dev/null 2>&1; then
        return 0
    else
        stop
        start
    fi
}

stop_service() {
    log_message "Stopping service"
    sed -i "/${CRON_ID}/d" /etc/crontabs/root 2>/dev/null
    /etc/init.d/cron restart 2>/dev/null || true
    restore_resolv_conf
}

service_stopped() {
    cleanup_netns
    log_message "dae runtime network cleanup completed."
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
}

hot_reload() {
    init_permissions_and_dirs
    
    if /etc/init.d/duck running >/dev/null 2>&1; then
        local dae_pid
        dae_pid="$(cat /var/run/dae.pid 2>/dev/null)"
        
        if [ -n "$dae_pid" ] && [ "$dae_pid" -gt 0 ] 2>/dev/null; then
            log_message "Hot-reloading InfinityDuck"
            "$PROG" reload "$dae_pid"
        else
            log_message "Invalid dae PID, cannot hot-reload" "warn"
        fi
    else
        log_message "InfinityDuck is not running, cannot hot-reload" "warn"
    fi
}
